#include <ESP8266WiFi.h>
#include "thingProperties.h"

#define GSR_PIN A0

unsigned long lastReconnect = 0;

void setup() {
  Serial.begin(9600);
  delay(2000);

  initProperties();

  ArduinoCloud.begin(ArduinoIoTPreferredConnection);

  setDebugMessageLevel(0);
  delay(8000);

  Serial.println("Setup complete");
}

void loop() {
  ArduinoCloud.update();

  if (!ArduinoCloud.connected()) {
    Serial.println("Trying to connect to cloud...");

    //Force reconnect every 10 sec
    if (millis() - lastReconnect > 10000) {
      Serial.println("Reconnecting WiFi + Cloud...");
      WiFi.disconnect();
      delay(2000);
      WiFi.begin(SECRET_SSID, SECRET_OPTIONAL_PASS);
      delay(5000);

      ArduinoCloud.begin(ArduinoIoTPreferredConnection);
      lastReconnect = millis();
    }

    return;
  }

  //If connected
  Serial.println("Connected to Cloud");

  int gsrRaw = analogRead(A0);
  GSR = gsrRaw;

  Serial.print("GSR: ");
  Serial.println(gsrRaw);
if (gsrRaw >= 120) {
      StressLevel = "HIGH";
    }
    else if (gsrRaw >= 80) {
      StressLevel = "MODERATE";
    }
    else {
      StressLevel = "LOW";
    }
  delay(3000);
}

// Required callbacks
void onStressLevelChange() {}
void onGSRChange() {}
